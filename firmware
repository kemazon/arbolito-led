  leds[quintaPosicion] = CHSV(random(256), 255, 255); // Color aleatorio para el segundo LED

  int sextaPosicion = (position +12) % NUM_LEDS; // Asegurarse de que esté dentro del rango
  leds[sextaPosicion] = CHSV(random(256), 255, 255); // Color aleatorio para el segundo LED

  int septimaPosicion = (position +16) % NUM_LEDS; // Asegurarse de que esté dentro del rango
  leds[septimaPosicion] = CHSV(random(256), 255, 255); // Color aleatorio para el segundo LED

  int octavaPosicion = (position +5) % NUM_LEDS; // Asegurarse de que esté dentro del rango
  leds[octavaPosicion] = CHSV(random(256), 255, 255); // Color aleatorio para el segundo LED

  int novenaPosicion = (position +11) % NUM_LEDS; // Asegurarse de que esté dentro del rango
  leds[novenaPosicion] = CHSV(random(256), 255, 255); // Color aleatorio para el segundo LED

