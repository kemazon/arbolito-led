}

void rainbowTrailEffect() {
  static int offset = 0;
  for (int i = 0; i < NUM_LEDS; i++) {
    leds[i] = CHSV((i + offset) * 255 / NUM_LEDS, 255, 255);
  }
  offset = (offset + 1) % 256;
  FastLED.show();
}

void colorWipe() {
  static int index = 0;
  leds[index] = CHSV(random(256), 255, 255);
  index = (index + 1) % NUM_LEDS;
  if(index == 0){
    FastLED.clear();
  }    
  else{
    FastLED.show();
  }
  //FastLED.show();
  //FastLED.clear();
}

void colorWipe2() {
  static int index = 0;
  leds[index] = CHSV(index * 10, 255, 255); // Gradiente de color basado en el índice
  index = (index + 1) % NUM_LEDS;
  FastLED.show();
  FastLED.clear();
}

void rainbowCycle() {
  static int offset = 0;
  for (int i = 0; i < NUM_LEDS; i++) {
    leds[i] = CHSV((i * 256 / NUM_LEDS + offset) & 255, 255, 255);
  }
  offset = (offset + 10) % 256;
  FastLED.show();
}

void strobe() {
  static bool on = false;
  fill_solid(leds, NUM_LEDS, on ? CHSV(random(256), random(255), random(255)) : CHSV(random(255), 255, 255));
  on = !on;
  FastLED.show();
  delay (200);
}

void runningLights(CRGB color) {
  static int position = 0;
  for (int i = 0; i < NUM_LEDS; i++) {
    leds[i] = color;
    leds[i].fadeToBlackBy(400 * abs((i + position) % NUM_LEDS - NUM_LEDS / 2) / (NUM_LEDS / 2));
  }
  position = (position + 1) % NUM_LEDS;
  FastLED.show();
}

void carouselEffect() {
  static int groupOffset = 0;
  const int groupSize = 3;
  const CRGB colors[7] = {CRGB::Red, CRGB::Orange, CRGB::Yellow, CRGB::Green, CRGB::Blue, CRGB::Indigo, CRGB::Violet};
  fill_solid(leds, NUM_LEDS, CRGB::Black);
  for (int i = 0; i < NUM_LEDS; i += groupSize) {
    for (int j = 0; j < groupSize; j++) {
      leds[(i + j + groupOffset) % NUM_LEDS] = colors[(i / groupSize) % 7];
    }
  }
  groupOffset = (groupOffset + 1) % NUM_LEDS;
  FastLED.show();
}
